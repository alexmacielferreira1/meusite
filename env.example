# MeuSite: crie um banco PostgreSQL NOVO e exclusivo. Não use o banco do Folios.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/meusite?sslmode=require
# Gere um segredo aleatório novo de pelo menos 32 bytes; não reutilize o do Folios.
LOGIN_HMAC_SECRET=GERAR_SEGREDO_NOVO
# JWT: outro segredo aleatório novo de pelo menos 32 bytes.
JWT_SECRET=GERAR_OUTRO_SEGREDO_NOVO
APP_ORIGINS=https://meusite.shardweb.app
COOKIE_SECURE=true
TRUSTED_PROXY_HOPS=2
CSP_MODE=relatorio
PORT=80
# Proprietário da administração: configure seu e-mail real no painel.
ADMIN_EMAILS=
# IA opcional. Sem chave, o site/editor/pedidos continuam funcionando.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_KEYS_SECRET=
# Configure o responsável e contato em backend/app/privacidade/privacidade.toml.

APP_ENV=production
# Observação pela Central: configure somente ao conectar o produto.
HUB_SERVICE_TOKEN=
